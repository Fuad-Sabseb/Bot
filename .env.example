# ==========================================
# CAMPUS SUPER APP - ENVIRONMENT CONFIGURATION
# ==========================================

# Server
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Database (PostgreSQL 16)
DATABASE_URL=postgresql://fuad.s@127.0.0.1:5432/campus_app?schema=public
TEST_DATABASE_URL=postgresql://fuad.s@127.0.0.1:5432/campus_app_test?schema=public

# Security & JWT
JWT_ACCESS_SECRET=replace_with_at_least_32_characters_random_secret_for_access_tokens
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_at_least_32_characters_random_secret_for_refresh_tokens
JWT_REFRESH_EXPIRES_IN=7d
TOKEN_ROTATION_GRACE_SECONDS=10
TOKEN_ENCRYPTION_KEY=replace_with_exact_32_byte_hex_or_base64_encryption_key_for_aes

# Telegram Bot
# IMPORTANT: Obtain a new bot token from @BotFather. Never commit the actual token.
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_FROM_BOTFATHER
TELEGRAM_ADMIN_CHAT_ID=5999909651
TELEGRAM_GROUP_CHAT_ID=-1003847746028

# Storage
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage

# AI Provider (Phase 8 preparation)
AI_PROVIDER=mock
AI_API_KEY=
