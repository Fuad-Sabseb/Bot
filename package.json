{
  "name": "campus-super-app",
  "version": "1.0.0",
  "description": "University Learning & Class Management Ecosystem",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p backend/tsconfig.json",
    "start": "node dist/server.js",
    "dev": "ts-node -r dotenv/config backend/src/server.ts",
    "bot:legacy": "node bot.js",
    "prisma:generate": "prisma generate --schema=backend/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate deploy --schema=backend/prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema=backend/prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=backend/prisma/schema.prisma",
    "migrate:legacy": "ts-node -r dotenv/config backend/scripts/migrate-legacy.ts",
    "test": "jest --runInBand --detectOpenHandles"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/s3-request-presigner": "^3.1164.0",
    "@neon/config": "^1.13.0",
    "@neon/env": "^2.1.0",
    "@neon/realtime": "^0.2.0",
    "@prisma/client": "^6.4.1",
    "axios": "^1.15.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-telegram-bot-api": "^0.67.0",
    "openai": "^6.34.0",
    "pdf-parse": "^2.4.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.10",
    "@types/node-telegram-bot-api": "^0.64.7",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "prisma": "^6.4.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
  }
}
